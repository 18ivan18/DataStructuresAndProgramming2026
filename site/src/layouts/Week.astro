---
import Base from './Base.astro';
import { REPO, WEEKS, quizHref, slidesHref } from '../data/weeks';

/* Layout for a week written in MDX: `layout: ../layouts/Week.astro` plus `week: 2`. */
const { frontmatter } = Astro.props;
const week = WEEKS.find((w) => w.n === frontmatter.week)!;
const folder = `${REPO}/tree/main/${week.folder}`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base title={`Седмица ${week.n}: ${frontmatter.title}`} description={frontmatter.description} current={week.page}>
  <header class="topic-head">
    <p class="eyebrow">Седмица {week.n}</p>
    <h1>{frontmatter.title}</h1>
    <p class="links"><a href={`${folder}#readme`}>README</a> · <a href={`${folder}/implementation`}>Реализации</a>{week.quiz && <> · <a href={quizHref(week, base)}>Тест</a></>}{week.slides && <> · <a href={slidesHref(week, base)}>Слайдове</a></>}</p>
  </header>
  <article class="prose">
    <slot />
  </article>
</Base>
