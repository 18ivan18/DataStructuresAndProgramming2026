---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz';
import { week06Quiz } from '../../data/quizzes/week06';
import { WEEKS, weekHref } from '../../data/weeks';

const week = WEEKS.find((w) => w.n === 6)!;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const material = weekHref(week, base);
---

<Base title={week06Quiz.title} description={week06Quiz.lead} current={`${week.page}/quiz`}>
  <header class="topic-head">
    <p class="eyebrow">Седмица {week.n} · тест</p>
    <h1>{week06Quiz.title}</h1>
    <p class="links">{week06Quiz.lead}</p>
    <p class="links"><a href={material}>← обратно към материала</a></p>
  </header>
  <Quiz quiz={week06Quiz} back={material} client:load />
</Base>
