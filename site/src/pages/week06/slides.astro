---
import Base from '../../layouts/Base.astro';
import Week06Deck from '../../components/Week06Deck';
import { WEEKS, quizHref, weekHref } from '../../data/weeks';

const week = WEEKS.find((w) => w.n === 6)!;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base
  title={`Слайдове: ${week.title}`}
  description="Презентация към упражнението за седмица 6: какво влиза в контролното, сложностите и инвариантите, правилата за указатели и техниките, с трасетата от бележките."
  bare
>
  <Week06Deck notes={weekHref(week, base)} quiz={quizHref(week, base)} client:load />
</Base>
