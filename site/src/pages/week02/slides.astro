---
import Base from '../../layouts/Base.astro';
import Week02Deck from '../../components/Week02Deck';
import { WEEKS, quizHref, weekHref } from '../../data/weeks';

const week = WEEKS.find((w) => w.n === 2)!;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base
  title={`Слайдове: ${week.title}`}
  description="Презентация към упражнението за седмица 2: динамичен масив, амортизирана сложност и стек, с интерактивните примери от бележките."
  bare
>
  <Week02Deck notes={weekHref(week, base)} quiz={quizHref(week, base)} client:load />
</Base>
