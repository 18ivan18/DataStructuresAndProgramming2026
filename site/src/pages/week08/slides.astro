---
import Base from '../../layouts/Base.astro';
import Week08Deck from '../../components/Week08Deck';
import { WEEKS, quizHref, weekHref } from '../../data/weeks';

const week = WEEKS.find((w) => w.n === 8)!;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base
  title={`Слайдове: ${week.title}`}
  description="Презентация към упражнението за седмица 8: наредбата, формата спрямо реда на вмъкване, трите операции, триенето с две деца, сериализацията и итераторът, с трасетата от бележките."
  bare
>
  <Week08Deck notes={weekHref(week, base)} quiz={quizHref(week, base)} client:load />
</Base>
