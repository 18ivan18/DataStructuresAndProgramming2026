---
import Base from '../../layouts/Base.astro';
import Week07Deck from '../../components/Week07Deck';
import { WEEKS, quizHref, weekHref } from '../../data/weeks';

const week = WEEKS.find((w) => w.n === 7)!;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base
  title={`Слайдове: ${week.title}`}
  description="Презентация към упражнението за седмица 7: понятията, записът по нива, четирите обхождания, шаблонът на рекурсията и цената ѝ по памет, с трасетата от бележките."
  bare
>
  <Week07Deck notes={weekHref(week, base)} quiz={quizHref(week, base)} client:load />
</Base>
