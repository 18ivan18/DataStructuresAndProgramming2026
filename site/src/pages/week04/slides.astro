---
import Base from '../../layouts/Base.astro';
import Week04Deck from '../../components/Week04Deck';
import { WEEKS, quizHref, weekHref } from '../../data/weeks';

const week = WEEKS.find((w) => w.n === 4)!;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base
  title={`Слайдове: ${week.title}`}
  description="Презентация към упражнението за седмица 4: възли и указатели, едносвързан и двусвързан списък, с решенията на задачите стъпка по стъпка."
  bare
>
  <Week04Deck notes={weekHref(week, base)} quiz={quizHref(week, base)} client:load />
</Base>
